# Backend — copy to backend/.env for local development.
# In Kubernetes these are supplied by the platform secret; do not commit real values.

# Postgres connection string used by Prisma (migrations and runtime).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# HS256 signing secret for API tokens. Must be set to a long random string in
# any non-local environment — the code falls back to a dev-only default.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h

# Port the NestJS API binds. nginx proxies /api to backend:3000.
PORT=3000

# Comma-separated allowed browser origins. Unset means "allow any origin",
# which is fine for a token-authenticated, cookie-free API.
FRONTEND_URL=http://localhost:4200

# Overrides the seeded demo password (manager@demo / clerk@demo).
SEED_PASSWORD=Demo1234!

# --- Optional backing services -------------------------------------------
# Object storage is not used by any StockRoom feature today; these keys exist so
# Admin → Settings can report configuration status. resolveConfig() reads the env
# var first and falls back to the SystemSetting row written by that panel.
# MINIO_ENDPOINT=http://minio:9000
# MINIO_BUCKET=stockroom
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=

# Discrete Postgres parts. Prisma uses DATABASE_URL above; these are surfaced in
# Admin → Settings so an operator can see which datastore the pod is bound to.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=app
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
